/* pages/jury/jury.wxss — v62-mp.1 multi-sage 多人对线 */
page { background: #eef2f7; height: 100%; }
.jury-container {
  display: flex; flex-direction: column;
  min-height: 100vh;
  padding: 0;
}

.jury-header {
  display: flex; align-items: center;
  padding: 24rpx 24rpx 16rpx;
  background: #0f172a;
  color: #fff;
}
.jury-back {
  font-size: 44rpx; line-height: 1;
  padding: 8rpx 20rpx 12rpx 0;
  color: #fff;
}
.jury-back-hover { opacity: 0.5; }
.jury-title { font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; }

.jury-intro {
  padding: 16rpx 24rpx 8rpx;
}
.jury-intro-text { font-size: 24rpx; color: #475569; }

.jury-sage-row {
  display: flex; gap: 16rpx; flex-wrap: wrap;
  padding: 12rpx 24rpx 4rpx;
}
.jury-sage-card {
  flex: 1 1 280rpx; min-width: 280rpx;
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 18rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  transition: all 0.15s;
}
.jury-sage-card-hover { transform: scale(0.99); }
.jury-sage-on { border-color: #3b82f6; box-shadow: 0 4rpx 14rpx rgba(59,130,246,0.18); }
.jury-sage-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 16rpx;
  color: #fff; font-weight: 700; font-size: 22rpx;
  font-family: ui-monospace, monospace;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.jury-sage-meta { flex: 1; min-width: 0; }
.jury-sage-name {
  font-size: 26rpx; font-weight: 600; color: #0f172a;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.jury-sage-philo {
  font-size: 22rpx; color: #64748b; margin-top: 4rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.jury-sage-check {
  width: 36rpx; height: 36rpx; border-radius: 9999rpx;
  background: #f1f5f9; color: transparent;
  font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s;
}
.jury-sage-check.on { background: #3b82f6; color: #fff; }

.jury-input-bar {
  display: flex; align-items: flex-end; gap: 12rpx;
  padding: 16rpx 24rpx 12rpx;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
  margin-top: 12rpx;
}
.jury-input {
  flex: 1; min-height: 64rpx; max-height: 200rpx;
  padding: 14rpx 18rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  font-size: 26rpx; color: #0f172a;
  line-height: 1.5;
}
.jury-input-ph { color: #94a3b8; }
.jury-send {
  background: #3b82f6; color: #fff;
  border-radius: 9999rpx;
  padding: 0 32rpx; height: 72rpx; line-height: 72rpx;
  font-size: 26rpx; font-weight: 600;
  border: none; margin: 0;
  box-shadow: 0 6rpx 18rpx rgba(59,130,246,0.25);
}
.jury-send::after { border: none; }
.jury-send-hover { transform: scale(0.96); }
.jury-send[disabled] { opacity: 0.4; box-shadow: none; }

.jury-starters {
  padding: 8rpx 24rpx 24rpx;
  display: flex; flex-wrap: wrap; gap: 12rpx;
}
.jury-starters-label {
  flex: 0 0 100%;
  font-size: 22rpx; color: #94a3b8; margin-bottom: 4rpx;
}
.jury-starter-chip {
  padding: 12rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 9999rpx;
  font-size: 24rpx; color: #334155;
}

.jury-results {
  flex: 1;
  padding: 16rpx 24rpx 32rpx;
}
.jury-result-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(15,23,42,0.05);
}
.jury-result-head {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 12rpx;
}
.jury-result-avatar {
  width: 48rpx; height: 48rpx; border-radius: 12rpx;
  color: #fff; font-weight: 700; font-size: 20rpx;
  font-family: ui-monospace, monospace;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.jury-result-name { flex: 1; font-size: 28rpx; font-weight: 700; color: #0f172a; }
.jury-result-badge {
  font-size: 20rpx; padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  font-weight: 600; flex-shrink: 0;
}
.jury-result-badge-running { background: #fef3c7; color: #92400e; }
.jury-result-badge-writing { background: #dbeafe; color: #1d4ed8; }
.jury-result-badge-done    { background: #d1fae5; color: #065f46; }
.jury-result-badge-err     { background: #fee2e2; color: #991b1b; }

.jury-result-tools {
  display: flex; flex-wrap: wrap; gap: 8rpx;
  margin-bottom: 10rpx;
}
.jury-tool-pill {
  font-size: 20rpx; padding: 4rpx 12rpx;
  background: #f1f5f9; color: #334155;
  border-radius: 8rpx;
}

.jury-result-body {
  font-size: 26rpx; line-height: 1.65;
  color: #1e293b;
  padding-top: 4rpx;
}
.jury-result-loading {
  font-size: 24rpx; color: #94a3b8;
  font-style: italic;
}
.jury-result-error {
  font-size: 24rpx; color: #b91c1c;
  background: #fef2f2;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  border-left: 3rpx solid #ef4444;
}

/* markdown 子集（与 chat 同色调，独立简化版 — 不依赖外部组件） */
.md-h { font-weight: 700; color: #0f172a; margin: 12rpx 0 6rpx; }
.md-h1 { font-size: 32rpx; }
.md-h2 { font-size: 28rpx; }
.md-h3 { font-size: 26rpx; }
.md-p { font-size: 26rpx; line-height: 1.85; color: #1e293b; margin: 8rpx 0; letter-spacing: 0.3rpx; }
.md-p + .md-p { margin-top: 12rpx; }
/* v62-mp.2: 分层小节 */
.md-section {
  display: flex; align-items: center; gap: 10rpx;
  margin: 18rpx 0 8rpx;
  padding-bottom: 5rpx;
  border-bottom: 1rpx dashed rgba(59,130,246,0.18);
}
.md-section:first-child { margin-top: 4rpx; }
.md-section-bar {
  width: 5rpx; height: 26rpx;
  background: linear-gradient(180deg, #3b82f6 0%, #1e40af 100%);
  border-radius: 4rpx; flex-shrink: 0;
}
.md-section-title { font-size: 26rpx; font-weight: 700; color: #1e40af; letter-spacing: 1rpx; }
.md-ul, .md-ol { margin: 4rpx 0; padding-left: 8rpx; }
.md-li { display: flex; gap: 8rpx; font-size: 26rpx; line-height: 1.65; color: #1e293b; }
.md-bullet, .md-num { color: #94a3b8; flex-shrink: 0; }
.md-li-body { flex: 1; }
.md-quote {
  border-left: 4rpx solid #cbd5e1;
  padding: 4rpx 12rpx; color: #475569;
  background: #f8fafc;
  margin: 6rpx 0;
}
.md-code-block {
  background: #0f172a; color: #e2e8f0;
  font-family: ui-monospace, monospace;
  font-size: 22rpx; padding: 12rpx 14rpx;
  border-radius: 10rpx; margin: 6rpx 0;
  white-space: pre-wrap;
}
.md-bold { font-weight: 700; }
.md-italic { font-style: italic; }
.md-inline-code {
  font-family: ui-monospace, monospace; font-size: 24rpx;
  background: #f1f5f9; padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
.md-text { display: inline; }
.md-hr {
  height: 2rpx; background: #e2e8f0;
  margin: 12rpx 0;
}
.cite-chip-static {
  display: inline-block;
  font-size: 20rpx; padding: 2rpx 8rpx;
  background: #dbeafe; color: #1d4ed8;
  border-radius: 6rpx;
  font-family: ui-monospace, monospace;
}

/* ============ v63-mp: jury 数据驱动卡（与 chat 视觉语言对齐，紧凑版） ============ */
/* facts 行（识别股票 + 数据深度） */
.jury-facts {
  display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap;
  padding: 8rpx 12rpx; margin-bottom: 12rpx;
  background: #f1f5f9; border-radius: 10rpx;
}
.jury-facts-name { font-weight: 700; color: #0f172a; font-size: 24rpx; }
.jury-facts-code {
  font-family: ui-monospace, monospace; font-size: 20rpx; color: #64748b;
  background: #fff; padding: 2rpx 8rpx; border-radius: 6rpx;
}
.jury-facts-market {
  font-size: 18rpx; color: #fff; background: #2563eb;
  padding: 2rpx 8rpx; border-radius: 6rpx; font-weight: 600;
}
.jury-facts-depth { font-size: 20rpx; color: #047857; font-weight: 500; }

/* 判决横幅（语义色 signal + headline + 置信度） */
.jury-verdict {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 16rpx; margin-bottom: 12rpx;
  border-radius: 14rpx; border: 1rpx solid transparent;
}
.jury-verdict-bull { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-color: #86efac; }
.jury-verdict-hold { background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); border-color: #cbd5e1; }
.jury-verdict-bear { background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-color: #fca5a5; }
.jury-verdict-pass { background: linear-gradient(135deg, #fefce8 0%, #fef9c3 100%); border-color: #fde047; }
.jury-vd-signal {
  font-size: 20rpx; font-weight: 700; padding: 5rpx 14rpx;
  border-radius: 9999rpx; color: #fff; flex-shrink: 0; letter-spacing: 1rpx;
}
.jury-vd-signal-bull { background: #10b981; }
.jury-vd-signal-hold { background: #64748b; }
.jury-vd-signal-bear { background: #ef4444; }
.jury-vd-signal-pass { background: #d97706; }
.jury-vd-headline { flex: 1; font-size: 24rpx; font-weight: 600; color: #0f172a; line-height: 1.4; }
.jury-vd-conf {
  font-family: ui-monospace, monospace; font-size: 20rpx; color: #475569;
  background: #fff; padding: 4rpx 10rpx; border-radius: 6rpx; flex-shrink: 0;
}

/* viz section 头（与 chat 同款，紧凑间距） */
.viz-sec { padding: 16rpx 2rpx 14rpx; border-bottom: 1rpx solid #eef2f7; }
.viz-sec-last { border-bottom: none; padding-bottom: 2rpx; }
.viz-h { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.viz-bar { width: 6rpx; height: 24rpx; border-radius: 3rpx; background: #2563eb; }
.viz-bar-gn { background: #0ea371; }
.viz-bar-mg { background: #831843; }
.viz-ti { font-size: 25rpx; font-weight: 800; color: #0f2540; letter-spacing: .5rpx; }
.viz-sub { margin-left: auto; font-size: 20rpx; color: #90a0b3; }

/* PE 估值标尺 */
.vz-gauge { margin-bottom: 22rpx; }
.vz-g-top { display: flex; align-items: baseline; gap: 10rpx; margin-bottom: 12rpx; }
.vz-g-lab { font-size: 24rpx; font-weight: 600; color: #5a6b80; }
.vz-g-val { font-size: 34rpx; font-weight: 800; color: #0f2540; }
.vz-g-unit { font-size: 22rpx; color: #90a0b3; }
.vz-g-tag { margin-left: auto; font-size: 20rpx; font-weight: 700; padding: 4rpx 12rpx; border-radius: 8rpx; }
.vz-tag-good { background: #e6f7f0; color: #0a7d56; }
.vz-tag-warn { background: #fdf3e3; color: #b8741c; }
.vz-tag-bad { background: #fde9e9; color: #c93b40; }
.vz-scale { position: relative; height: 16rpx; border-radius: 10rpx;
  background: linear-gradient(90deg, #0ea371 0%, #7bc96f 28%, #f5d472 55%, #e0922f 78%, #e5484d 100%); }
.vz-mk { position: absolute; top: -8rpx; width: 8rpx; height: 32rpx; border-radius: 6rpx;
  background: #0f2540; box-shadow: 0 0 0 4rpx #fff; transform: translateX(-50%); }
.vz-scale-x { display: flex; justify-content: space-between; margin-top: 10rpx; font-size: 18rpx; color: #90a0b3; }

/* 对比条（股息 vs 国债 / EY / PB） */
.vz-cmp { margin-bottom: 18rpx; }
.vz-cmp-last { margin-bottom: 0; }
.vz-cmp-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 10rpx; }
.vz-cmp-lab { width: 140rpx; font-size: 22rpx; color: #5a6b80; flex: 0 0 auto; }
.vz-track { flex: 1; height: 34rpx; background: #eef2f7; border-radius: 9rpx; overflow: hidden; }
.vz-fill { height: 100%; border-radius: 9rpx; display: flex; align-items: center; justify-content: flex-end; min-width: 60rpx; }
.vz-fill-t { font-size: 20rpx; font-weight: 700; color: #fff; padding-right: 12rpx; }
.vz-gd { background: linear-gradient(90deg, #0ea371, #13b87f); }
.vz-nt { background: linear-gradient(90deg, #94a3b8, #aab6c6); }
.vz-cmp-note { font-size: 21rpx; color: #0a7d56; font-weight: 600; margin-top: 4rpx; line-height: 1.5; }

/* 指标小卡（成长 & 质地） */
.vz-tiles { display: flex; flex-wrap: wrap; gap: 14rpx; }
.vz-tile { width: calc(50% - 7rpx); background: #f8fafc; border: 1rpx solid #e6ebf2; border-radius: 16rpx; padding: 16rpx; box-sizing: border-box; }
.vz-tl { font-size: 20rpx; color: #90a0b3; display: block; margin-bottom: 8rpx; }
.vz-tv { font-size: 34rpx; font-weight: 800; color: #0f2540; line-height: 1; }
.vz-tu { font-size: 22rpx; color: #90a0b3; font-weight: 600; }
.vz-up { color: #0ea371; }
.vz-dn { color: #e5484d; }
.vz-tbar { height: 10rpx; border-radius: 5rpx; background: #eef2f7; margin-top: 12rpx; overflow: hidden; }
.vz-tbar-i { display: block; height: 100%; border-radius: 5rpx; }
.vz-bg-gn { background: #0ea371; }
.vz-bg-bl { background: #2563eb; }

/* 五维评分行（dossier dims） */
.vz-dim { display: flex; align-items: flex-start; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx dashed #e6ebf2; }
.vz-dim:last-child { border-bottom: none; padding-bottom: 0; }
.vz-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 8rpx; flex: 0 0 auto; }
.vz-dot-p { background: #0ea371; box-shadow: 0 0 0 6rpx #e6f7f0; }
.vz-dot-f { background: #e5484d; box-shadow: 0 0 0 6rpx #fde9e9; }
.vz-dc { flex: 1; }
.vz-dim-top { display: flex; align-items: center; gap: 14rpx; margin-bottom: 8rpx; }
.vz-dim-lab { font-size: 24rpx; font-weight: 700; color: #0f2540; flex: 0 0 auto; }
.vz-dim-track { flex: 1; height: 10rpx; background: #eef2f7; border-radius: 5rpx; overflow: hidden; }
.vz-dim-i { display: block; height: 100%; background: #0ea371; border-radius: 5rpx; }
.vz-dim-i-f { background: #e5484d; }
.vz-dim-w { font-size: 19rpx; color: #90a0b3; flex: 0 0 auto; }
.vz-dim-note { font-size: 22rpx; color: #5a6b80; line-height: 1.55; }
