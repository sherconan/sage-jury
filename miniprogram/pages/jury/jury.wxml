<!-- pages/jury/jury.wxml — v62-mp.1 multi-sage 多人对线 -->
<!-- 复用 chat.wxml 同款 markdown template -->
<template name="md-jury-inlines">
  <block wx:for="{{inlines}}" wx:for-item="seg" wx:key="index">
    <text wx:if="{{seg.type === 'text'}}" class="md-text">{{seg.text}}</text>
    <text wx:elif="{{seg.type === 'code'}}" class="md-inline-code">{{seg.text}}</text>
    <text wx:elif="{{seg.type === 'cite'}}" class="cite-chip-static">#{{seg.n}}</text>
    <text wx:elif="{{seg.type === 'bold'}}" class="md-bold">{{seg.text}}</text>
    <text wx:elif="{{seg.type === 'italic'}}" class="md-italic">{{seg.text}}</text>
  </block>
</template>

<template name="md-jury-blocks">
  <block wx:for="{{blocks}}" wx:for-item="b" wx:key="index">
    <view wx:if="{{b.type === 'heading'}}" class="md-h md-h{{b.level}}">
      <template is="md-jury-inlines" data="{{inlines: b.inlines}}" />
    </view>
    <view wx:elif="{{b.type === 'p'}}" class="md-p">
      <template is="md-jury-inlines" data="{{inlines: b.inlines}}" />
    </view>
    <view wx:elif="{{b.type === 'section'}}" class="md-section">
      <text class="md-section-bar"></text>
      <text class="md-section-title">{{b.title}}</text>
    </view>
    <view wx:elif="{{b.type === 'ul'}}" class="md-ul">
      <view wx:for="{{b.items}}" wx:for-item="li" wx:key="*this" class="md-li">
        <text class="md-bullet">•</text>
        <view class="md-li-body"><template is="md-jury-inlines" data="{{inlines: li.inlines}}" /></view>
      </view>
    </view>
    <view wx:elif="{{b.type === 'ol'}}" class="md-ol">
      <view wx:for="{{b.items}}" wx:for-item="li" wx:key="*this" class="md-li">
        <text class="md-num">{{li.num}}.</text>
        <view class="md-li-body"><template is="md-jury-inlines" data="{{inlines: li.inlines}}" /></view>
      </view>
    </view>
    <view wx:elif="{{b.type === 'quote'}}" class="md-quote">
      <template is="md-jury-inlines" data="{{inlines: b.inlines}}" />
    </view>
    <view wx:elif="{{b.type === 'code'}}" class="md-code-block">{{b.text}}</view>
    <view wx:elif="{{b.type === 'hr'}}" class="md-hr"></view>
  </block>
</template>

<view class="jury-container">
  <view class="jury-header">
    <view class="jury-back" bindtap="onBack" hover-class="jury-back-hover">‹</view>
    <view class="jury-title">多人对线 · 大佬并行评分</view>
  </view>

  <view class="jury-intro">
    <text class="jury-intro-text">选 2-5 位大佬，一起对线你这笔交易决策。</text>
  </view>

  <view class="jury-sage-row">
    <view wx:for="{{sages}}" wx:key="slug"
      class="jury-sage-card {{selectedSlugs.indexOf(item.slug) >= 0 ? 'jury-sage-on' : ''}}"
      data-slug="{{item.slug}}" bindtap="onSageToggle" hover-class="jury-sage-card-hover">
      <view class="jury-sage-avatar" style="background:{{item.color}}">{{item.initials}}</view>
      <view class="jury-sage-meta">
        <view class="jury-sage-name">{{item.display}}</view>
        <view class="jury-sage-philo">{{item.philosophy}}</view>
      </view>
      <view class="jury-sage-check {{selectedSlugs.indexOf(item.slug) >= 0 ? 'on' : ''}}">
        {{selectedSlugs.indexOf(item.slug) >= 0 ? '✓' : ''}}
      </view>
    </view>
  </view>

  <view class="jury-input-bar">
    <textarea class="jury-input" placeholder="例如：茅台还能买吗？" value="{{input}}"
      bindinput="onInputChange" disabled="{{loading}}" maxlength="500"
      auto-height adjust-position cursor-spacing="20" placeholder-class="jury-input-ph" />
    <button class="jury-send" bindtap="onSubmit" disabled="{{loading || !input}}" loading="{{loading}}" hover-class="jury-send-hover">
      <text wx:if="{{!loading}}">开始对线</text>
      <text wx:else>对线中</text>
    </button>
  </view>

  <view wx:if="{{!loading && !runUid}}" class="jury-starters">
    <view class="jury-starters-label">试试这些问题</view>
    <view wx:for="{{starters}}" wx:key="*this" class="jury-starter-chip" data-q="{{item}}" bindtap="onStarter">{{item}}</view>
  </view>

  <scroll-view class="jury-results" scroll-y wx:if="{{runUid > 0}}">
    <view wx:for="{{selectedSlugs}}" wx:for-item="slug" wx:key="*this" class="jury-result-card">
      <block wx:if="{{sageStates[slug]}}">
        <view class="jury-result-head">
          <view class="jury-result-avatar" style="background:{{sageStates[slug].color}}">{{sageStates[slug].initials}}</view>
          <view class="jury-result-name">{{sageStates[slug].display}}</view>
          <view wx:if="{{sageStates[slug].error}}" class="jury-result-badge jury-result-badge-err">异常</view>
          <view wx:elif="{{sageStates[slug].done}}" class="jury-result-badge jury-result-badge-done">已审 ✓</view>
          <view wx:elif="{{sageStates[slug].writerStarted}}" class="jury-result-badge jury-result-badge-writing">落笔中…</view>
          <view wx:else class="jury-result-badge jury-result-badge-running">分析中 ⟳</view>
        </view>

        <!-- 识别股票 + 数据深度（facts，若 server 路由到 jury 则显示） -->
        <view wx:if="{{sageStates[slug].facts && sageStates[slug].facts.hasTicker}}" class="jury-facts">
          <text class="jury-facts-name">{{sageStates[slug].facts.name}}</text>
          <text wx:if="{{sageStates[slug].facts.code}}" class="jury-facts-code">{{sageStates[slug].facts.code}}</text>
          <text wx:if="{{sageStates[slug].facts.market}}" class="jury-facts-market">{{sageStates[slug].facts.market}}</text>
          <text wx:if="{{sageStates[slug].facts.v62 && sageStates[slug].facts.years}}" class="jury-facts-depth">· {{sageStates[slug].facts.years}} 年深度</text>
        </view>

        <!-- 判决横幅（语义色 signal + headline + 置信度） -->
        <view wx:if="{{sageStates[slug].verdict}}" class="jury-verdict jury-verdict-{{sageStates[slug].verdict.tone}}">
          <view class="jury-vd-signal jury-vd-signal-{{sageStates[slug].verdict.tone}}">{{sageStates[slug].verdict.signal}}</view>
          <view class="jury-vd-headline">{{sageStates[slug].verdict.headline || '5 维加权评分'}}</view>
          <text wx:if="{{sageStates[slug].verdict.confidence !== null}}" class="jury-vd-conf">{{sageStates[slug].verdict.confidence}}%</text>
        </view>

        <!-- 紧凑版可视化（若有 verdict.viz） -->
        <view wx:if="{{sageStates[slug].verdict.viz && sageStates[slug].verdict.viz.hasValuation}}" class="viz-sec">
          <view class="viz-h"><text class="viz-bar"></text><text class="viz-ti">估值体检</text><text class="viz-sub">现在贵不贵</text></view>
          <view wx:if="{{sageStates[slug].verdict.viz.pe}}" class="vz-gauge">
            <view class="vz-g-top">
              <text class="vz-g-lab">PE-TTM</text>
              <text class="vz-g-val">{{sageStates[slug].verdict.viz.pe.val}}</text>
              <text class="vz-g-unit">倍</text>
              <text class="vz-g-tag vz-tag-{{sageStates[slug].verdict.viz.pe.tagTone}}">{{sageStates[slug].verdict.viz.pe.tag}}</text>
            </view>
            <view class="vz-scale"><view class="vz-mk" style="left:{{sageStates[slug].verdict.viz.pe.markerPct}}%"></view></view>
            <view class="vz-scale-x"><text>便宜 8×</text><text>合理 20×</text><text>贵 50×+</text></view>
          </view>
          <view wx:if="{{sageStates[slug].verdict.viz.div}}" class="vz-cmp">
            <view class="vz-cmp-row"><text class="vz-cmp-lab">股息率</text><view class="vz-track"><view class="vz-fill vz-gd" style="width:{{sageStates[slug].verdict.viz.div.pct}}%"><text class="vz-fill-t">{{sageStates[slug].verdict.viz.div.val}}%</text></view></view></view>
            <view class="vz-cmp-row"><text class="vz-cmp-lab">10Y 国债</text><view class="vz-track"><view class="vz-fill vz-nt" style="width:{{sageStates[slug].verdict.viz.div.bondPct}}%"><text class="vz-fill-t">{{sageStates[slug].verdict.viz.div.bond}}%</text></view></view></view>
            <view wx:if="{{sageStates[slug].verdict.viz.div.beats}}" class="vz-cmp-note">✓ 股息 {{sageStates[slug].verdict.viz.div.val}}% ＞ 国债 {{sageStates[slug].verdict.viz.div.bond}}%（利差 +{{sageStates[slug].verdict.viz.div.diff}}pct）</view>
          </view>
          <view wx:if="{{sageStates[slug].verdict.viz.ey || sageStates[slug].verdict.viz.pb}}" class="vz-cmp vz-cmp-last">
            <view wx:if="{{sageStates[slug].verdict.viz.ey}}" class="vz-cmp-row"><text class="vz-cmp-lab">盈利收益率</text><view class="vz-track"><view class="vz-fill vz-gd" style="width:{{sageStates[slug].verdict.viz.ey.pct}}%"><text class="vz-fill-t">EY {{sageStates[slug].verdict.viz.ey.val}}%</text></view></view></view>
            <view wx:if="{{sageStates[slug].verdict.viz.pb}}" class="vz-cmp-row"><text class="vz-cmp-lab">PB</text><view class="vz-track"><view class="vz-fill vz-nt" style="width:{{sageStates[slug].verdict.viz.pb.pct}}%"><text class="vz-fill-t">{{sageStates[slug].verdict.viz.pb.val}}×</text></view></view></view>
          </view>
        </view>

        <view wx:if="{{sageStates[slug].verdict.viz && sageStates[slug].verdict.viz.hasGrowth}}" class="viz-sec">
          <view class="viz-h"><text class="viz-bar viz-bar-gn"></text><text class="viz-ti">成长 & 质地</text><text class="viz-sub">生意好不好</text></view>
          <view class="vz-tiles">
            <view wx:if="{{sageStates[slug].verdict.viz.revC}}" class="vz-tile"><text class="vz-tl">营收 5年 CAGR</text><view class="vz-tv {{sageStates[slug].verdict.viz.revC.up ? 'vz-up' : 'vz-dn'}}">{{sageStates[slug].verdict.viz.revC.up ? '+' : ''}}{{sageStates[slug].verdict.viz.revC.val}}<text class="vz-tu">%</text></view><view class="vz-tbar"><view class="vz-tbar-i vz-bg-gn" style="width:{{sageStates[slug].verdict.viz.revC.pct}}%"></view></view></view>
            <view wx:if="{{sageStates[slug].verdict.viz.npC}}" class="vz-tile"><text class="vz-tl">净利 5年 CAGR</text><view class="vz-tv {{sageStates[slug].verdict.viz.npC.up ? 'vz-up' : 'vz-dn'}}">{{sageStates[slug].verdict.viz.npC.up ? '+' : ''}}{{sageStates[slug].verdict.viz.npC.val}}<text class="vz-tu">%</text></view><view class="vz-tbar"><view class="vz-tbar-i vz-bg-gn" style="width:{{sageStates[slug].verdict.viz.npC.pct}}%"></view></view></view>
            <view wx:if="{{sageStates[slug].verdict.viz.roe}}" class="vz-tile"><text class="vz-tl">ROE 5年均</text><view class="vz-tv">{{sageStates[slug].verdict.viz.roe.val}}<text class="vz-tu">%</text></view><view class="vz-tbar"><view class="vz-tbar-i vz-bg-bl" style="width:{{sageStates[slug].verdict.viz.roe.pct}}%"></view></view></view>
            <view wx:if="{{sageStates[slug].verdict.viz.gm}}" class="vz-tile"><text class="vz-tl">销售毛利率</text><view class="vz-tv">{{sageStates[slug].verdict.viz.gm.val}}<text class="vz-tu">%</text></view><view class="vz-tbar"><view class="vz-tbar-i vz-bg-bl" style="width:{{sageStates[slug].verdict.viz.gm.pct}}%"></view></view></view>
          </view>
        </view>

        <view wx:if="{{sageStates[slug].verdict.dims && sageStates[slug].verdict.dims.length}}" class="viz-sec viz-sec-last">
          <view class="viz-h"><text class="viz-bar viz-bar-mg"></text><text class="viz-ti">五维体检</text><text class="viz-sub">{{sageStates[slug].verdict.dimsPassText}}</text></view>
          <view wx:for="{{sageStates[slug].verdict.dims}}" wx:for-item="dim" wx:key="key" class="vz-dim">
            <view class="vz-dot vz-dot-{{dim.pass ? 'p' : 'f'}}"></view>
            <view class="vz-dc">
              <view class="vz-dim-top">
                <text class="vz-dim-lab">{{dim.label}}</text>
                <view class="vz-dim-track"><view class="vz-dim-i {{dim.pass ? '' : 'vz-dim-i-f'}}" style="width:{{dim.barPct}}%"></view></view>
                <text wx:if="{{dim.weight !== null}}" class="vz-dim-w">{{dim.weight}}%</text>
              </view>
              <view class="vz-dim-note">{{dim.note}}</view>
            </view>
          </view>
        </view>

        <!-- 工具调用 pills -->
        <view wx:if="{{sageStates[slug].toolCalls && sageStates[slug].toolCalls.length}}" class="jury-result-tools">
          <text wx:for="{{sageStates[slug].toolCalls}}" wx:for-item="tc" wx:key="id" class="jury-tool-pill">
            {{tc.icon}} {{tc.label}}{{tc.result ? ' ✓' : ' ⟳'}}
          </text>
        </view>

        <!-- 答案正文 / 错误态 / 加载态 -->
        <view wx:if="{{sageStates[slug].error}}" class="jury-result-error">
          ⚠️ {{sageStates[slug].error}}
        </view>
        <view wx:elif="{{sageStates[slug].contentBlocks && sageStates[slug].contentBlocks.length}}" class="jury-result-body">
          <template is="md-jury-blocks" data="{{blocks: sageStates[slug].contentBlocks}}" />
        </view>
        <view wx:elif="{{sageStates[slug].content}}" class="jury-result-body">
          <text>{{sageStates[slug].content}}</text>
        </view>
        <view wx:else class="jury-result-loading">
          <text>{{sageStates[slug].display}} 正在调取数据 + 评分…</text>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
