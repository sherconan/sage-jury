.container { display: flex; flex-direction: column; min-height: 100vh; background: #eef2f7; }

/* ========== Top bar ========== */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx; background: #fff; border-bottom: 1rpx solid #e6ebf2;
}
.topbar-title { font-size: 32rpx; font-weight: 600; color: #0f2540; }
.topbar-count {
  margin-left: 12rpx; font-size: 22rpx; color: #90a0b3; font-weight: 500;
  background: #eef2f7; padding: 2rpx 16rpx; border-radius: 9999rpx;
}
.header-btn {
  font-size: 22rpx; padding: 8rpx 18rpx; background: #fde9e9; color: #c93b40;
  border: 1rpx solid #f7cdcd; border-radius: 9999rpx; margin: 0; line-height: 1.6;
}
.header-btn::after { border: none; }
.header-btn-danger { background: #fde9e9; color: #c93b40; }

/* ========== Search bar ========== */
.search-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 24rpx; margin: 16rpx 24rpx 0; background: #fff;
  border: 1rpx solid #e6ebf2; border-radius: 9999rpx;
}
.search-icon { font-size: 22rpx; color: #90a0b3; }
.search-input { flex: 1; font-size: 26rpx; color: #0f2540; }
.search-clear {
  font-size: 22rpx; color: #90a0b3; padding: 4rpx 12rpx;
  background: #eef2f7; border-radius: 9999rpx;
}

/* ========== Session list ========== */
.list { flex: 1; padding: 16rpx 24rpx 24rpx; }

.sess-item {
  display: flex; align-items: flex-start; gap: 18rpx;
  background: #fff; border: 1rpx solid #e6ebf2; border-radius: 16rpx;
  padding: 22rpx 22rpx; margin-bottom: 14rpx;
  transition: all 0.2s;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(15,37,64,0.04);
}
.sess-item-hover { background: #f6f9fd; }
.sess-item-streaming {
  border-color: #b6d0fb;
  background: linear-gradient(135deg, #fff 0%, #eaf1ff 100%);
  box-shadow: 0 0 0 2rpx rgba(37,99,235,0.12);
}

.sess-avatar {
  width: 80rpx; height: 80rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 700; font-size: 22rpx;
  font-family: ui-monospace, monospace;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.sess-body { flex: 1; min-width: 0; overflow: hidden; }
.sess-title-row {
  display: flex; align-items: center; gap: 10rpx;
}
.sess-title {
  font-size: 28rpx; font-weight: 600; color: #0f2540;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  flex: 1; min-width: 0;
}
/* v63-mp: 列表卡判决徽章（看好/观察/不碰/能力圈外）—— 软底+深字，与 chat 判决横幅同语义色 */
.sess-verdict {
  font-size: 18rpx; font-weight: 700; line-height: 1;
  padding: 4rpx 12rpx; border-radius: 9999rpx; flex-shrink: 0;
  letter-spacing: 0.5rpx;
}
.sess-verdict-bull { background: #e6f7f0; color: #0a7d56; }
.sess-verdict-hold { background: #eef2f7; color: #5a6b80; }
.sess-verdict-bear { background: #fde9e9; color: #c93b40; }
.sess-verdict-pass { background: #fdf3e3; color: #b8741c; }
.sess-streaming-dot {
  width: 14rpx; height: 14rpx; border-radius: 9999rpx;
  background: #2563eb;
  box-shadow: 0 0 0 0 rgba(37,99,235,0.4);
  animation: pulse 1.6s ease-out infinite;
  flex-shrink: 0;
}
@keyframes pulse {
  0%   { box-shadow: 0 0 0 0   rgba(37,99,235,0.5); }
  70%  { box-shadow: 0 0 0 12rpx rgba(37,99,235,0); }
  100% { box-shadow: 0 0 0 0   rgba(37,99,235,0); }
}
.sess-preview {
  font-size: 24rpx; color: #5a6b80; line-height: 1.5;
  margin-top: 8rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.sess-meta {
  display: flex; gap: 8rpx; flex-wrap: wrap;
  font-size: 22rpx; color: #90a0b3;
  margin-top: 10rpx;
}
.sess-sep { color: #c3ccd8; }
.sess-sage { color: #5a6b80; font-weight: 500; }
.sess-streaming-label { color: #2563eb; font-weight: 500; }

.del-btn {
  font-size: 32rpx; width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  color: #c3ccd8; background: transparent;
  border-radius: 9999rpx;
}
.del-btn:active { background: #fde9e9; color: #e5484d; }

/* ========== Empty state ========== */
.empty-state {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 120rpx 32rpx;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.7; }
.empty-title { font-size: 30rpx; font-weight: 600; color: #0f2540; }
.empty-sub { font-size: 24rpx; color: #90a0b3; margin-top: 8rpx; text-align: center; }
.primary-btn {
  background: linear-gradient(135deg, #2563eb, #4f46e5); color: #fff;
  font-size: 26rpx; padding: 16rpx 48rpx; border-radius: 9999rpx;
  border: none; line-height: 1.6; margin-top: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.28);
}
.primary-btn::after { border: none; }
